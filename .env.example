# Copy to .env and edit. Every value here is a default — the app runs with none
# of them set, fully offline, using the stub model and the in-process store.

# --- Chat model -------------------------------------------------------------
# stub = deterministic, offline, no credentials (default). bedrock = real Claude.
ENGRAM_CHAT_PROVIDER=stub
ENGRAM_AWS_REGION=us-east-1
ENGRAM_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
ENGRAM_BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
ENGRAM_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Embeddings -------------------------------------------------------------
# hashing = deterministic, zero-dependency (default, and what CI uses)
# fastembed = real semantics offline, needs: pip install -e ".[embed]"
# bedrock = Amazon Titan v2
ENGRAM_EMBEDDER=hashing

# --- Stores -----------------------------------------------------------------
# memory = in-process. postgres = PostgresSaver + pgvector (docker compose up).
ENGRAM_STORE_BACKEND=memory
ENGRAM_POSTGRES_DSN=postgresql://engram:engram@localhost:5432/engram

# --- Memory write path ------------------------------------------------------
# manager = extract, dedupe, resolve conflicts, decay (default)
# naive   = store every turn verbatim; the benchmark's control arm
ENGRAM_MEMORY_WRITER=manager
ENGRAM_DEDUPE_SIMILARITY=0.9

# --- Retrieval --------------------------------------------------------------
ENGRAM_RECALL_TOP_K=5

# --- Logging ----------------------------------------------------------------
ENGRAM_LOG_LEVEL=INFO
ENGRAM_LOG_FORMAT=console
